# Copy to .env and fill in. The real .env is git-ignored - never commit it.

# --- LLM (required for ask / eval / build-index / rag-benchmark) ---
OPENAI_API_KEY=
# Optional: only for OpenAI-compatible proxies. Leave unset for api.openai.com.
# OPENAI_BASE_URL=

# --- Optional overrides (nested settings use a double underscore) ---
# LLM__MODEL=gpt-4o-mini
# LLM__JUDGE_MODEL=gpt-4o-mini
# LLM__EMBEDDING_MODEL=text-embedding-3-small
# LOCATION__NAME="San Francisco, CA"
# HOUSEHOLD__CO2_KG_PER_KWH=0.4
# PATHS__DB=data/energy_data.db
# LOG_LEVEL=INFO
